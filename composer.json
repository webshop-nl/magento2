{
    "name": "webshop-nl/magento2",
    "description": "Webshopnl extension for Magento 2",
    "type": "magento2-module",
    "version": "1.2.0",
    "license": "BSD-2-Clause",
    "require": {
        "magento/framework": ">=103.0.6",
        "php": ">=8.2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "WebshopNL\\Connect\\": ""
        }
    },
    "extra": {
        "magmodules": {
            "module-name": {
                "en": "Webshop.nl",
                "nl": "Webshop.nl"
            },
            "links": {
                "product": {
                    "en": "https://www.magmodules.eu/magento2-webshop-marketplace.html",
                    "nl": "https://www.magmodules.nl/magento2-webshop-marketplace.html"
                },
                "docs": {
                    "en": "https://www.magmodules.eu/help/magento2-webshop-marketplace.html",
                    "nl": "https://www.magmodules.nl/help/magento2-webshop-marketplace.html"
                },
                "support": {
                    "en": "https://www.magmodules.eu/support",
                    "nl": "https://www.magmodules.nl/support"
                }
            }
        }
    }
}
