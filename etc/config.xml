<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <webshopnl>
            <general>
                <version>v1.2.0</version>
                <installation_id></installation_id>
                <enable>0</enable>
                <mode>development</mode>
                <debug>0</debug>
            </general>
            <feeds>
                <results></results>
            </feeds>
            <feed>
                <enable>0</enable>
                <filename>webshop.ndjson</filename>
                <cron_frequency>0 0 * * *</cron_frequency>
                <configurable>both</configurable>
                <bundle>both</bundle>
                <grouped>both</grouped>
                <name_attribute>name</name_attribute>
                <description_attribute>short_description</description_attribute>
                <description_long_attribute>description</description_long_attribute>
                <image>image</image>
                <brand_attribute>manufacturer</brand_attribute>
                <ean_attribute>sku</ean_attribute>
                <size_attribute>size</size_attribute>
                <color_attribute>color</color_attribute>
                <material_attribute>material</material_attribute>
                <gender_attribute>gender</gender_attribute>
                <vat_pct_enabled>0</vat_pct_enabled>
                <vat_pct_source>static</vat_pct_source>
                <vat_pct_static>21</vat_pct_static>
                <delivery_source>static</delivery_source>
                <configurable_non_visible>0</configurable_non_visible>
                <bundle_non_visible>0</bundle_non_visible>
                <grouped_non_visible>0</grouped_non_visible>
                <filter_visibility>0</filter_visibility>
                <filter_category>0</filter_category>
                <filter_type_category>in</filter_type_category>
                <filter_stock>0</filter_stock>
                <custom_filters>0</custom_filters>
            </feed>
            <order>
                <shipping_method>webshopnl_webshopnl</shipping_method>
                <import_customer>0</import_customer>
                <separate_house_number>0</separate_house_number>
                <order_email>0</order_email>
                <invoice_order_email>0</invoice_order_email>
                <log>0</log>
                <last_order_import></last_order_import>
            </order>
        </webshopnl>
        <payment>
            <webshopnl>
                <active>1</active>
                <model>WebshopNL\Connect\Model\Payment\Webshopnl</model>
                <order_status>pending</order_status>
                <title>Webshopnl Payment</title>
                <allowspecific>0</allowspecific>
            </webshopnl>
        </payment>
        <carriers>
            <webshopnl>
                <active>1</active>
                <sallowspecific>0</sallowspecific>
                <model>WebshopNL\Connect\Model\Carrier\Webshopnl</model>
                <name>Webshopnl Shipping</name>
                <title>Webshopnl</title>
                <price>0.00</price>
                <type>I</type>
                <overwrite_title>0</overwrite_title>
                <overwrite_name>0</overwrite_name>
            </webshopnl>
        </carriers>
    </default>
</config>
